generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntryType {
  INCOME
  EXPENSE
}

enum FixedVariable {
  FIXED
  VARIABLE
}

enum Essentiality {
  ESSENTIAL
  NON_ESSENTIAL
}

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum BudgetStatus {
  UNDER_BUDGET
  NEAR_LIMIT
  OVER_BUDGET
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

model User {
  id                     String     @id @default(cuid())
  uid                    String     @unique
  email                  String     @unique
  name                   String
  phone                  String?
  role                   UserRole   @default(USER)
  status                 UserStatus @default(PENDING)
  passwordHash           String?
  mustChangePassword     Boolean    @default(false)
  twoFactorEnabled       Boolean    @default(false)
  twoFactorSecret        String?
  twoFactorPendingSecret String?
  twoFactorBackupCodes   String[]   @default([])
  sessionVersion         Int        @default(0)
  resetOtpHash           String?
  resetOtpExpiry         DateTime?
  resetOtpAttempts       Int        @default(0)
  failedLoginAttempts    Int        @default(0)
  lockedUntil            DateTime?
  onboardedAt            DateTime?
  approvedAt             DateTime?
  approvedById           String?
  rejectedAt             DateTime?
  rejectionReason        String?
  lastLoginAt            DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  categories     Category[]
  accounts       Account[]
  paymentMethods PaymentMethodType[]
  transactions   Transaction[]
  budgets        Budget[]
  investments    Investment[]
  bills          Bill[]
  goals          Goal[]
  notifications  Notification[]
  activityLogs   ActivityLog[]
  activityLogsAsTarget ActivityLog[] @relation("ActivityLogTarget")
  settings       AppSettings?
  profile        AppProfile?
  backupConnections BackupConnection[]
  passkeys       Passkey[]
  consent        ConsentRecord?
  recoverySessions  RecoverySession[]
  securityQuestions SecurityQuestion[]
  sessions          Session[]
  entitlement       UserEntitlement?
  impersonationRequestsMade    ImpersonationRequest[] @relation("ImpersonationAdmin")
  impersonationRequestsAgainst ImpersonationRequest[] @relation("ImpersonationTarget")

  @@index([status])
}

/// "Access as User" break-glass flow — scoped OTP for this one flow only, not a generic OTP
/// system. Same shape as the existing recovery OTP fields on User (otpHash/otpExpiresAt/attempts).
model ImpersonationRequest {
  id           String    @id @default(cuid())
  admin        User      @relation("ImpersonationAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  adminId      String
  target       User      @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetUserId String
  otpHash      String
  otpExpiresAt DateTime
  attempts     Int       @default(0)
  consumedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([adminId])
  @@index([targetUserId])
}

/// Extensible, non-billing per-user feature/limit config — explicitly NOT a subscription/billing
/// system. `planLabel` is free text (room for FREE/PRO/BUSINESS/ENTERPRISE later without an enum
/// migration), `features`/`limits` are open JSON maps (same "typed-JSON-blob" house style as
/// AppSettings.data/AppProfile.data) so new keys never need a schema change.
model UserEntitlement {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String   @unique
  planLabel      String   @default("FREE")
  features       Json     @default("{}")
  limits         Json     @default("{}")
  restricted     Boolean  @default(false)
  notifyEligible Boolean  @default(true)
  emailEligible  Boolean  @default(true)
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Session {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  ip         String?
  userAgent  String?
  browser    String?
  os         String?
  device     String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
  @@index([revokedAt])
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
}

enum AnnouncementType {
  INFO
  UPDATE
  MAINTENANCE
  SECURITY
  FEATURE
  IMPORTANT
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String
  type        AnnouncementType     @default(INFO)
  priority    AnnouncementPriority @default(NORMAL)
  status      AnnouncementStatus   @default(DRAFT)
  audience    String               @default("ALL")
  publishAt   DateTime?
  expireAt    DateTime?
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status])
  @@index([publishAt])
}

/// Persisted override for a code-defined transactional template in lib/emailTemplates.ts
/// (EMAIL_TEMPLATES registry). The registry stays the DEFAULT/fallback content; a row here
/// overrides subject/html for that templateKey when `enabled`. Deleting the row (or never
/// creating one) means "use the code default" — this is the mechanism behind Restore Default.
model EmailTemplateOverride {
  id          String   @id @default(cuid())
  templateKey String   @unique
  subject     String?
  html        String?
  enabled     Boolean  @default(true)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Per-trigger config for an existing automated send call site (identified by triggerKey, e.g.
/// "welcome_email", "password_reset_by_admin") — lets an admin disable a specific automated
/// email or point it at a different registry template, without touching code. Only created for
/// triggers that genuinely exist as sendEmail(...) call sites — see notify.ts/auth.routes.ts.
model EmailAutomationConfig {
  id          String   @id @default(cuid())
  triggerKey  String   @unique
  templateKey String?
  enabled     Boolean  @default(true)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

enum RecoveryState {
  // Legacy values from the sequential v2 flow — no longer written by new
  // code, kept only so the enum type change stays additive (old rows, if
  // any, remain valid). Do not use in new code.
  REQUESTED
  SECURITY_REQUIRED
  SECURITY_VERIFIED
  // Choice-based v3 flow states.
  STARTED
  METHOD_SELECTED
  OTP_VERIFIED
  TOTP_VERIFIED
  SECURITY_QUESTIONS_VERIFIED
  AUTHORIZED
  COMPLETED
  EXPIRED
  LOCKED
}

// Server-authoritative, choice-based account-recovery session. The client
// never sees this row's identifier or the raw recovery token — the token
// exists only inside a Secure+HttpOnly+signed cookie the browser cannot read
// via JavaScript; only this row's SHA-256 hash of it is stored. `method`
// records which single recovery method the user picked (email OTP, TOTP, or
// security questions) — once picked, only that method's verification
// endpoint can advance the session to AUTHORIZED, and no other method's
// state fields are trusted. Single-use: consumedAt is set the instant a
// password reset succeeds, and every recovery endpoint checks it first.
model RecoverySession {
  id               String        @id @default(cuid())
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  tokenHash        String        @unique
  state            RecoveryState @default(STARTED)
  // "EMAIL_OTP" | "TOTP" | "SECURITY_QUESTIONS" — set once, at select-method time.
  method           String?
  otpHash          String?
  otpExpiresAt     DateTime?
  otpAttempts      Int           @default(0)
  otpResendCount   Int           @default(0)
  otpLastSentAt    DateTime?
  totpAttempts     Int           @default(0)
  securityAttempts Int           @default(0)
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

// Exactly two rows per user today (position 1/2), structured to allow more
// later. answerHash is bcrypt(normalize(answer)) — the plaintext answer is
// never stored or returned anywhere.
model SecurityQuestion {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  questionKey String
  answerHash  String
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, position])
  @@index([userId])
}

// Legal/account metadata only (who accepted what, and when) — never financial
// data, which lives in the user's own Google Drive per the app's architecture.
model ConsentRecord {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String   @unique
  signedName      String
  termsAccepted   Boolean
  privacyAccepted Boolean
  termsVersion    String
  privacyVersion  String
  acceptedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
}

model Category {
  id            String        @id @default(cuid())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  name          String
  type          EntryType
  subcategories Subcategory[]
  transactions  Transaction[]
  budgets       Budget[]
  createdAt     DateTime      @default(now())

  @@unique([userId, name])
}

model Subcategory {
  id         String       @id @default(cuid())
  name       String
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  transactions Transaction[]

  @@unique([categoryId, name])
}

model Account {
  id           String        @id @default(cuid())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  name         String
  transactions Transaction[]
  createdAt    DateTime      @default(now())

  @@unique([userId, name])
}

model PaymentMethodType {
  id           String        @id @default(cuid())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  name         String
  transactions Transaction[]
  createdAt    DateTime      @default(now())

  @@unique([userId, name])
}

model Transaction {
  id             String         @id @default(cuid())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  date           DateTime
  description    String
  amount         Decimal        @db.Decimal(14, 2)
  type           EntryType
  category       Category       @relation(fields: [categoryId], references: [id])
  categoryId     String
  subcategory    Subcategory?   @relation(fields: [subcategoryId], references: [id])
  subcategoryId  String?
  merchant       String?
  account        Account?       @relation(fields: [accountId], references: [id])
  accountId      String?
  paymentMethodType   PaymentMethodType? @relation(fields: [paymentMethodTypeId], references: [id])
  paymentMethodTypeId String?
  location       String?
  tags           String[]       @default([])
  notes          String?
  recurring      Boolean        @default(false)
  fixedVariable  FixedVariable?
  essentiality   Essentiality?
  attachmentUrl  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([date])
  @@index([categoryId])
  @@index([type])
}

model Budget {
  id         String       @id @default(cuid())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  category   Category     @relation(fields: [categoryId], references: [id])
  categoryId String
  period     BudgetPeriod @default(MONTHLY)
  periodKey  String       // e.g. "2026-07" for monthly, "2026-Q2", "2026" for yearly
  amount     Decimal      @db.Decimal(14, 2)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([categoryId, period, periodKey])
}

model Investment {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  instrument         String
  category           String
  investedAmount     Decimal  @db.Decimal(14, 2) @default(0)
  currentValue       Decimal  @db.Decimal(14, 2)
  purchaseDate       DateTime @default(now())
  monthlyContribution Decimal @db.Decimal(14, 2) @default(0)
  annualReturnPct    Decimal  @db.Decimal(5, 2)  @default(0)
  platform           String?
  notes              String?
  isAutoSync         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

model Bill {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  name          String
  type          String
  dueDate       DateTime
  amount        Decimal   @db.Decimal(14, 2)
  paidAmount    Decimal   @db.Decimal(14, 2) @default(0)
  autoPay       Boolean   @default(false)
  interestRate  Decimal?  @db.Decimal(5, 2)
  tenureMonths  Int?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model Goal {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  name               String
  category           String
  targetAmount       Decimal  @db.Decimal(14, 2)
  currentAmount      Decimal  @db.Decimal(14, 2) @default(0)
  monthlyContribution Decimal @db.Decimal(14, 2) @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

model ActivityLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  // Explicit target of an admin→user action (force-logout, role change, password/UID reset,
  // entitlement change, impersonation events, etc.) — null for self-actions and for every
  // historical row predating this column. `userId` keeps meaning exactly what it always has
  // (the actor); this is purely additive. onDelete: SetNull (not Cascade, unlike userId above)
  // — deleting the target account must not delete the audit history of what was done to it.
  target      User?    @relation("ActivityLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetUserId String?
  event     String
  detail    String?
  ip        String?
  userAgent String?
  browser   String?
  os        String?
  device    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([targetUserId])
  @@index([createdAt])
}

model AppSettings {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique
  data   Json   @default("{}")

  @@map("app_settings")
}

model AppProfile {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique
  data   Json   @default("{}")

  @@map("app_profile")
}

// Provider-abstracted cloud backup connection. `provider` distinguishes which
// One row per WebAuthn credential (passkey) a user has registered — a Windows
// Hello / Touch ID / Face ID / Android biometric / security key enrollment.
// Users can register several, one per device/authenticator.
model Passkey {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  // Base64url-encoded WebAuthn credential ID — what the authenticator sends back on login.
  credentialId String    @unique
  // Base64url-encoded COSE public key, used to verify future assertions. Never a secret an
  // attacker could sign with, so plaintext storage is standard WebAuthn practice.
  publicKey    String
  // Signature counter, used to detect cloned authenticators (must only ever increase).
  counter      BigInt    @default(0)
  deviceType   String // "singleDevice" | "multiDevice", from the credential's backup eligibility
  backedUp     Boolean   @default(false)
  transports   String[]  @default([])
  name         String // user-editable label, e.g. "Windows Hello" or "iPhone Face ID"
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

// cloud (google_drive today; onedrive/dropbox/icloud can reuse this same table
// later) a user has linked, so adding a new provider needs no schema change.
model BackupConnection {
  id                   String    @id @default(cuid())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String
  provider             String
  accountEmail         String?
  // Encrypted at rest (see backend/src/lib/crypto.ts) — never stored or logged in plaintext.
  accessToken          String
  refreshToken         String?
  tokenExpiresAt       DateTime?
  // Set only once setupWorkspace() has verified the Drive workspace is fully ready — see
  // services/drive/init.ts. Null here (even with tokens saved) means "connected but not
  // yet migrated/initialized", which the admin Migration Status view relies on.
  backupFolderId       String?
  // Operational visibility into the connect/migrate flow, for the admin Migration Status
  // view only — never used by any user-facing logic. Set by drive.routes.ts on every
  // connect attempt; lastConnectError is cleared on a subsequent success.
  lastConnectAttemptAt DateTime?
  lastConnectError     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([userId, provider])
}

model PlatformSettings {
  id                          String   @id @default("singleton")
  siteName                    String   @default("Penny Pilot")
  supportEmail                String?
  defaultSessionTimeoutMinutes Int     @default(30)
  minPasswordLength           Int      @default(8)
  require2FAForAdmins         Boolean  @default(false)
  updatedAt                   DateTime @updatedAt

  @@map("platform_settings")
}
