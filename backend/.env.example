DATABASE_URL="postgresql://pfd_user:pfd_password@localhost:5432/pfd_pro?schema=public"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
NODE_ENV=development

# Auth provider feature flag: "legacy" (default, password/JWT/2FA/passkeys — unchanged)
# or "clerk" (Clerk-verified sessions). See backend/src/middleware/auth.ts.
AUTH_PROVIDER=legacy
# Required only when AUTH_PROVIDER=clerk. From the Clerk Dashboard -> API Keys.
CLERK_SECRET_KEY=
