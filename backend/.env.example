DATABASE_URL="postgresql://pfd_user:pfd_password@localhost:5432/pfd_pro?schema=public"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
NODE_ENV=development

# Canonical frontend origin(s) — comma-separated if more than one (e.g. after a Vercel
# rename). Used for CORS, CSRF origin checks, and building the Google OAuth redirect base.
APP_URL="http://localhost:3000"
FRONTEND_URL=""

# Auth
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
COOKIE_SECRET="change-me"

# Google Drive — Penny Pilot's primary storage for every user's financial data. See the
# "Data Storage: Google Drive" section in README.md for how to create these in Google Cloud
# Console. GOOGLE_REDIRECT_URI must exactly match an Authorized redirect URI on that OAuth
# client and point at this backend's own /api/drive/callback (not the frontend).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/drive/callback"
# Any random string, 32+ characters — encrypts stored Google OAuth tokens at rest.
BACKUP_TOKEN_ENCRYPTION_KEY=""

# Outbound email (optional — account/security emails, admin test-send). Leave unset to no-op.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
SUPER_ADMIN_RESEND_API_KEY=""
SUPER_ADMIN_RESEND_FROM_EMAIL=""
