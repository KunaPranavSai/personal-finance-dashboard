NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth provider feature flag: "legacy" (default, existing password/2FA/passkey login,
# unchanged) or "clerk". Must match the backend's AUTH_PROVIDER. See
# frontend/src/lib/authProvider.ts.
NEXT_PUBLIC_AUTH_PROVIDER=legacy
# Required only when NEXT_PUBLIC_AUTH_PROVIDER=clerk. From the Clerk Dashboard -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
