NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical site URL used for metadataBase, canonical URLs, sitemap.xml, and
# robots.txt. Defaults to https://pennypilot.pro when unset; only override
# for local/staging (e.g. NEXT_PUBLIC_APP_URL=http://localhost:3000).
NEXT_PUBLIC_APP_URL=https://pennypilot.pro

# Optional: Google Search Console HTML-tag verification token (Settings >
# Ownership verification > HTML tag, the `content` value only). Leave unset
# if verifying via DNS (Domain property) instead — DNS verification needs no
# app changes.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: Bing Webmaster Tools verification token (the `content` value of
# the msvalidate.01 meta tag Bing gives you).
NEXT_PUBLIC_BING_SITE_VERIFICATION=
